---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import RouteMap from '../components/RouteMap.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../site.config';
import { getPosts, routePoints } from '../lib/posts';

const posts = await getPosts();
const [latest, ...rest] = posts;
const points = routePoints(posts);
const current = points.at(-1);
---
<Base>
  <section class="hero wrap">
    <p class="eyebrow">{current ? `Currently in ${current.location}` : 'Travel journal'}</p>
    <h1>{SITE.title}</h1>
    <p class="tagline">{SITE.tagline}</p>
  </section>

  {latest ? (
    <section class="wrap latest">
      <PostCard post={latest} featured />
    </section>
  ) : (
    <section class="wrap empty"><p>The first story is on its way.</p></section>
  )}

  <section class="wrap route">
    <div class="route-head">
      <h2>The route so far</h2>
      <a href="/map/">Full map →</a>
    </div>
    <RouteMap points={points} height="22rem" />
  </section>

  {rest.length > 0 && (
    <section class="wrap">
      <h2 class="section-title">Earlier stories</h2>
      <div class="grid">
        {rest.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}

  <section class="wrap sub"><Subscribe /></section>
</Base>

<style>
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem); max-width: 46rem; margin-left: max(1.25rem, (100% - var(--max)) / 2); }
  .hero h1 { margin: 0.4rem 0 0.8rem; }
  .tagline { font-size: 1.2rem; color: var(--ink-soft); margin: 0; }
  .latest { margin-bottom: 5rem; }
  .empty { color: var(--muted); }
  .route { margin-bottom: 5rem; }
  .route-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
  .route-head h2 { margin: 0; }
  .section-title { margin: 0 0 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 2.5rem 1.75rem; }
  .sub { margin-top: 5rem; }
</style>
