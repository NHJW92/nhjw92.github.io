---
import PostView from '../../../views/Post.astro';
import { getPosts, type Post } from '../../../lib/posts';
import type { Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of ['en', 'de'] as Lang[]) {
    const posts = await getPosts(lang);
    paths.push(
      ...posts.map((post, i) => ({
        params: { lang, id: post.id },
        props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts },
      })),
    );
  }
  return paths;
}
type Props = { post: Post; newer?: Post; older?: Post; all: Post[] };
---
<PostView {...(Astro.props as Props)} />
