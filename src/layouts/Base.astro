---
import '../styles/global.css';
import { SITE } from '../site.config';
import { LANGS, LANG_NAMES, LOCALES, DEFAULT_LANG, localize, splitPath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
}
const { lang, title, image } = Astro.props;
const s = t(lang);
const description = Astro.props.description ?? s.description;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
// Language-neutral path of this page, e.g. "/map/" for "/en/map/".
const { path } = splitPath(Astro.url.pathname);
const nav = [
  { path: '/', label: s.nav.stories },
  { path: '/map/', label: s.nav.route },
  { path: '/about/', label: s.nav.about },
];
const isCurrent = (p: string) => (p === '/' ? path === '/' || path.startsWith('/posts/') : path.startsWith(p));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(localize(path, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localize(path, DEFAULT_LANG), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={localize('/rss.xml', lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={LOCALES[lang].replace('-', '_')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#f7f2e9" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={localize('/', lang)}>{SITE.title}</a>
        <div class="right">
          <nav aria-label="Main">
            {nav.map((n) => (
              <a href={localize(n.path, lang)} aria-current={isCurrent(n.path) ? 'page' : undefined}>{n.label}</a>
            ))}
          </nav>
          <nav class="langs" aria-label={s.language}>
            {LANGS.map((l) => (
              <a href={localize(path, l)} hreflang={l} lang={l} title={LANG_NAMES[l]} aria-current={l === lang ? 'true' : undefined} data-lang={l}>
                {l.toUpperCase()}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span><a href={localize('/rss.xml', lang)}>RSS</a></span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 1000;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 3.75rem; }
  .brand { font-family: var(--serif); font-weight: 650; font-size: 1.2rem; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .right { display: flex; align-items: center; gap: 0.75rem; }
  nav { display: flex; gap: 0.25rem; }
  nav a {
    color: var(--ink-soft); text-decoration: none; font-size: 0.95rem; font-weight: 500;
    padding: 0.4rem 0.7rem; border-radius: 999px; transition: background-color 150ms ease, color 150ms ease;
  }
  nav a:hover { background: var(--paper-2); color: var(--ink); }
  nav a[aria-current='page'] { color: var(--teal); background: var(--paper-2); }
  .langs { border-left: 1px solid var(--line); padding-left: 0.6rem; gap: 0; }
  .langs a { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; padding: 0.35rem 0.45rem; color: var(--muted); }
  .langs a[aria-current='true'] { color: var(--clay); background: none; }
  main { min-height: 70vh; }
  .site-footer { border-top: 1px solid var(--line); margin-top: 5rem; }
  .foot { display: flex; justify-content: space-between; padding: 1.75rem 0; color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 640px) {
    .bar { height: auto; flex-wrap: wrap; padding: 0.6rem 0; row-gap: 0.25rem; }
    .brand { font-size: 1.05rem; }
    .right { width: calc(100% + 0.5rem); margin-left: -0.5rem; justify-content: space-between; }
    nav a { padding: 0.35rem 0.5rem; font-size: 0.9rem; }
  }
</style>
