---
import '../styles/global.css';
import { SITE } from '../site.config';
import { LANGS, LANG_NAMES, LOCALES, DEFAULT_LANG, localize, splitPath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  /** The page opens with a full-bleed photo: the masthead floats over it until you scroll. */
  overlay?: boolean;
}
const { lang, title, image, overlay = false } = Astro.props;
const s = t(lang);
const description = Astro.props.description ?? s.description;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
// Language-neutral path of this page, e.g. "/map/" for "/en/map/".
const { path } = splitPath(Astro.url.pathname);
const nav = [
  { path: '/', label: s.nav.stories },
  { path: '/map/', label: s.nav.route },
  { path: '/about/', label: s.nav.about },
];
const isCurrent = (p: string) => (p === '/' ? path === '/' || path.startsWith('/posts/') : path.startsWith(p));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(localize(path, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localize(path, DEFAULT_LANG), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={localize('/rss.xml', lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={LOCALES[lang].replace('-', '_')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#eceee8" />
  </head>
  <body class:list={{ overlay }}>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="masthead" data-masthead>
      <div class="wrap bar">
        <a class="brand" href={localize('/', lang)}>
          <span class="name">{SITE.title}</span>
          <span class="edition" aria-hidden="true">{s.edition}</span>
        </a>
        <div class="right">
          <nav aria-label="Main" class="main-nav">
            {nav.map((n) => (
              <a href={localize(n.path, lang)} aria-current={isCurrent(n.path) ? 'page' : undefined}>{n.label}</a>
            ))}
          </nav>
          <nav class="langs" aria-label={s.language}>
            {LANGS.map((l) => (
              <a href={localize(path, l)} hreflang={l} lang={l} title={LANG_NAMES[l]} aria-current={l === lang ? 'true' : undefined} data-lang={l}>
                {l.toUpperCase()}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="colophon on-deep">
      <div class="wrap foot">
        <div class="mark">
          <a class="big" href={localize('/', lang)}>{SITE.title}</a>
          <p>{s.colophon}</p>
        </div>
        <nav aria-label="Footer" class="foot-nav">
          {nav.map((n) => <a href={localize(n.path, lang)}>{n.label}</a>)}
          <a href={localize('/rss.xml', lang)}>RSS</a>
        </nav>
        <p class="small">© {new Date().getFullYear()} {SITE.author}</p>
      </div>
    </footer>
    <div class="grain" aria-hidden="true"></div>

    <script>
      // Entrances: reveal elements as they enter the viewport, once.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }

      // Masthead over a cover photo: turn solid once the photo scrolls away.
      const head = document.querySelector<HTMLElement>('[data-masthead]');
      if (head && document.body.classList.contains('overlay')) {
        let raf = 0;
        const update = () => {
          raf = 0;
          head.classList.toggle('solid', window.scrollY > Math.max(80, window.innerHeight * 0.55));
        };
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
        addEventListener('resize', update, { passive: true });
        update();
      }

      // Pause the whisper animations on hidden tabs.
      document.addEventListener('visibilitychange', () => document.body.classList.toggle('paused', document.hidden));
    </script>
  </body>
</html>

<style>
  .masthead {
    position: sticky; top: 0; z-index: 1000;
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(12px);
    -webkit-backdrop-filter: saturate(1.2) blur(12px);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition: background-color 400ms var(--ease-soft), border-color 400ms var(--ease-soft), color 400ms var(--ease-soft);
  }
  .overlay .masthead {
    position: fixed; inset: 0 0 auto;
    background: transparent; border-bottom-color: transparent; color: #f4f5f0;
    backdrop-filter: none; -webkit-backdrop-filter: none;
  }
  .overlay .masthead::before {
    content: ''; position: absolute; inset: 0 0 -2.5rem; z-index: -1; pointer-events: none;
    background: linear-gradient(rgb(8 14 20 / 0.55), rgb(8 14 20 / 0));
    transition: opacity 400ms var(--ease-soft);
  }
  .overlay .masthead.solid {
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    border-bottom-color: var(--line); color: var(--ink);
    backdrop-filter: saturate(1.2) blur(12px); -webkit-backdrop-filter: saturate(1.2) blur(12px);
  }
  .overlay .masthead.solid::before { opacity: 0; }
  .overlay .masthead:not(.solid) :focus-visible { outline-color: var(--accent); }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4rem; }
  .brand { display: inline-flex; align-items: baseline; gap: 0.7rem; color: inherit; text-decoration: none; white-space: nowrap; }
  .name { font-family: var(--display); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.01em; }
  .edition { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.75; }
  .right { display: flex; align-items: center; gap: 1rem; }
  nav { display: flex; gap: 0.1rem; }
  nav a {
    position: relative; color: inherit; text-decoration: none;
    font-family: var(--mono); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.6rem 0.65rem;
  }
  .main-nav a::after {
    content: ''; position: absolute; left: 0.65rem; right: 0.65rem; bottom: 0.35rem; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 350ms var(--ease-out);
  }
  .main-nav a:hover::after, .main-nav a[aria-current='page']::after { transform: scaleX(1); }
  .main-nav a[aria-current='page']::after { height: 2px; background: var(--accent); }
  .langs { padding-left: 0.8rem; border-left: 1px solid currentColor; border-left-color: color-mix(in srgb, currentColor 30%, transparent); }
  .langs a { padding: 0.6rem 0.4rem; opacity: 0.7; transition: opacity 200ms var(--ease-soft); }
  .langs a:hover { opacity: 1; }
  .langs a[aria-current='true'] { opacity: 1; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.45em; }

  main { min-height: 70vh; outline: none; }

  .colophon { margin-top: clamp(5rem, 10vw, 8rem); }
  .foot { display: grid; gap: 2rem; padding: clamp(3rem, 7vw, 5rem) 0 2rem; grid-template-columns: 1fr; }
  .big {
    display: block; font-family: var(--display); font-weight: 500; text-decoration: none; color: var(--ink);
    font-size: clamp(2.6rem, 9vw, 7.5rem); line-height: 0.95; letter-spacing: -0.03em;
  }
  .mark p { margin: 1rem 0 0; color: var(--muted); font-style: italic; max-width: 40ch; }
  .foot-nav { flex-wrap: wrap; gap: 0.25rem 0.5rem; margin-left: -0.65rem; }
  .foot-nav a { color: var(--ink-2); }
  .foot-nav a:hover { color: var(--accent); }
  .small { margin: 0; padding-top: 1.5rem; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; color: var(--muted); }
  @media (min-width: 900px) {
    .foot { grid-template-columns: 1fr auto; align-items: end; }
    .small { grid-column: 1 / -1; }
  }

  @media (max-width: 720px) {
    .bar { height: auto; flex-wrap: wrap; padding: 0.55rem 0 0.3rem; row-gap: 0; }
    .name { font-size: 1.2rem; }
    /* Phones: brand and languages share the top row, sections get the second. */
    .right { display: contents; }
    .brand { order: 1; }
    .langs { order: 2; margin-left: auto; margin-right: -0.4rem; padding-left: 0; border-left: 0; }
    .main-nav { order: 3; width: calc(100% + 1rem); margin-left: -0.5rem; }
    nav a { padding: 0.75rem 0.5rem; font-size: 0.68rem; letter-spacing: 0.08em; white-space: nowrap; }
    .main-nav a::after { left: 0.5rem; right: 0.5rem; }
  }
  @media (max-width: 400px) { .edition { display: none; } }
</style>
