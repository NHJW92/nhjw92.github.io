---
import type { MapPoint } from '../lib/posts';
import { SITE } from '../site.config';
import { t, type Lang } from '../i18n/ui';

interface Props {
  points: MapPoint[];
  height?: string;
  /** Highlight a single point (used on post pages). */
  focus?: { lat: number; lng: number };
  legend?: boolean;
  lang: Lang;
}
const { points, height = '28rem', focus, legend = true, lang } = Astro.props;
const s = t(lang);
const modes = new Set(points.slice(1).map((p) => p.travel));
const showFlight = modes.has('flight');
const showBoat = modes.has('boat');
const showGround = [...modes].some((m) => m !== 'flight' && m !== 'boat' && m !== 'start');
---
<figure class="route-figure">
  <div class="route-map" style={`--h:${height}`} data-points={JSON.stringify(points)} data-focus={focus ? JSON.stringify(focus) : ''} data-carto-key={SITE.map.cartoApiKey} data-stop-label={s.map.stop}>
    <noscript><p>{s.map.needsJs}</p></noscript>
  </div>
  {legend && points.length > 1 && (
    <figcaption class="legend">
      {showGround && <span><i class="ground"></i>{s.legend.overland}</span>}
      {showBoat && <span><i class="boat"></i>{s.legend.boat}</span>}
      {showFlight && <span><i class="flight"></i>{s.legend.flight}</span>}
      <span><b class="dot story"></b>{s.legend.story}</span>
      {points.some((p) => p.kind === 'stop') && <span><b class="dot stop"></b>{s.legend.stop}</span>}
    </figcaption>
  )}
</figure>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Point = {
    kind: 'story' | 'stop'; title: string; url?: string; date: string; location: string;
    note?: string; lat: number; lng: number; travel: string;
  };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const STYLE: Record<string, L.PolylineOptions> = {
    flight: { color: '#121a22', weight: 2.4, dashArray: '0.1 7', lineCap: 'round', opacity: 0.9 },
    boat: { color: '#2c6e8f', weight: 2.5, dashArray: '8 6', opacity: 0.95 },
    ground: { color: '#121a22', weight: 2.6, opacity: 0.85 },
  };

  /** Gentle arc between two points, so flights read as flights. */
  function arc(a: [number, number], b: [number, number], steps = 48): [number, number][] {
    const [lat1, lng1] = a, [lat2, lng2] = b;
    const dLat = lat2 - lat1, dLng = lng2 - lng1;
    const dist = Math.hypot(dLat, dLng);
    // Control point: midpoint pushed perpendicular (towards the pole side).
    const k = 0.18 * dist;
    const nx = -dLat / (dist || 1), ny = dLng / (dist || 1);
    const sign = ny >= 0 ? 1 : -1;
    const c: [number, number] = [(lat1 + lat2) / 2 + sign * ny * k, (lng1 + lng2) / 2 + sign * nx * k];
    const out: [number, number][] = [];
    for (let i = 0; i <= steps; i++) {
      const t = i / steps, u = 1 - t;
      out.push([u * u * lat1 + 2 * u * t * c[0] + t * t * lat2, u * u * lng1 + 2 * u * t * c[1] + t * t * lng2]);
    }
    return out;
  }

  function init(el: HTMLElement) {
    if (el.dataset.ready) return;
    el.dataset.ready = '1';
    const points: Point[] = JSON.parse(el.dataset.points || '[]');
    const focus = el.dataset.focus ? (JSON.parse(el.dataset.focus) as { lat: number; lng: number }) : null;

    const map = L.map(el, { scrollWheelZoom: false, worldCopyJump: true });
    const cartoKey = el.dataset.cartoKey;
    if (cartoKey) {
      L.tileLayer(`https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=${encodeURIComponent(cartoKey)}`, {
        maxZoom: 19,
        subdomains: 'abcd',
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      }).addTo(map);
    } else {
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);
    }

    // Legs: each point's `travel` describes how you got there from the previous one.
    for (let i = 1; i < points.length; i++) {
      const a: [number, number] = [points[i - 1].lat, points[i - 1].lng];
      const b: [number, number] = [points[i].lat, points[i].lng];
      const mode = points[i].travel;
      if (mode === 'flight') L.polyline(arc(a, b), STYLE.flight).addTo(map);
      else L.polyline([a, b], mode === 'boat' ? STYLE.boat : STYLE.ground).addTo(map);
    }

    points.forEach((p, i) => {
      const isLast = i === points.length - 1;
      const isFocus = !!focus && focus.lat === p.lat && focus.lng === p.lng;
      const story = p.kind === 'story';
      L.circleMarker([p.lat, p.lng], {
        radius: story ? (isFocus || isLast ? 8 : 6.5) : 4.5,
        color: story ? (isFocus || isLast ? '#121a22' : '#fff') : '#121a22',
        weight: 2,
        fillColor: isFocus || (isLast && !focus) ? '#e2a11b' : story ? '#121a22' : '#fff',
        fillOpacity: 1,
      })
        .addTo(map)
        .bindPopup(
          story
            ? `<div class="pop"><span class="pop-loc">${esc(p.location)}</span><a href="${p.url}">${esc(p.title)}</a><span class="pop-date">${esc(p.date)}</span></div>`
            : `<div class="pop"><span class="pop-loc">${esc(el.dataset.stopLabel || 'Stop')}</span><strong>${esc(p.title)}</strong>${p.note ? `<span>${esc(p.note)}</span>` : ''}<span class="pop-date">${esc(p.date)}</span></div>`,
        );
    });

    const latlngs = points.map((p) => [p.lat, p.lng] as [number, number]);
    if (focus) {
      map.setView([focus.lat, focus.lng], 7);
    } else if (latlngs.length) {
      map.fitBounds(L.latLngBounds(latlngs).pad(0.15), { maxZoom: 8 });
    } else {
      // Indonesia overview when there are no points yet.
      map.fitBounds([[-11, 95], [6, 141]]);
    }
    map.on('click', () => map.scrollWheelZoom.enable());
    el.addEventListener('mouseleave', () => map.scrollWheelZoom.disable());
  }

  document.querySelectorAll<HTMLElement>('.route-map').forEach(init);
</script>

<style>
  .route-figure { margin: 0; }
  .route-map {
    /* Popups sit on white, so they always use the light-page ink, even inside a dark band. */
    --ink: #121a22; --muted: #566270;
    height: var(--h);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    overflow: hidden;
    background: #dfe3dc;
    z-index: 0;
  }
  /* Quiet the tiles so the route reads first. */
  .route-map :global(.leaflet-tile-pane) { filter: saturate(0.55) contrast(1.03) brightness(1.02); }
  .legend {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; margin-top: 0.9rem;
    font-family: var(--label); font-size: 0.76rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted);
  }
  .legend span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .legend i { display: inline-block; width: 1.8rem; height: 0; border-top: 2px solid currentColor; }
  .legend i.boat { border-top: 2px dashed #5b9bbd; }
  .legend i.flight { border-top: 3px dotted currentColor; }
  .legend .dot { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; }
  .legend .dot.story { background: currentColor; }
  .legend .dot.stop { width: 0.6rem; height: 0.6rem; border: 2px solid currentColor; }
  .route-map :global(.leaflet-popup-content-wrapper) { border-radius: 4px; box-shadow: 0 10px 30px rgb(8 14 20 / 0.25); }
  .route-map :global(.pop) { display: grid; gap: 0.2rem; font-family: var(--serif); color: var(--ink); }
  .route-map :global(.pop a), .route-map :global(.pop strong) { font-family: var(--display); font-size: 1.15rem; font-weight: 500; color: var(--ink); text-decoration: none; line-height: 1.15; }
  .route-map :global(.pop a:hover) { text-decoration: underline; }
  .route-map :global(.pop-loc) { font-family: var(--label); font-size: 0.72rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .route-map :global(.pop-date) { font-family: var(--label); font-size: 0.78rem; color: var(--muted); }
  .route-map :global(.leaflet-control-attribution) { font-family: var(--label); font-size: 0.68rem; }
</style>
