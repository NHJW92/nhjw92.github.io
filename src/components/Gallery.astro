---
import { Image, getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';
import { t, type Lang } from '../i18n/ui';

interface Props { items: { image: string; caption?: string | null; alt?: string }[]; lang: Lang; album?: boolean }
const { items, lang, album = false } = Astro.props;
const s = t(lang).gallery;

const photos = await Promise.all(
  items.map(async (item) => {
    const src = resolveImage(item.image)!;
    const large = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp', quality: 80 });
    return { src, large: large.src, caption: item.caption ?? '', alt: item.alt ?? item.caption ?? '' };
  }),
);
// Magazine spread: an odd count opens with one wide photo, the rest run in pairs,
// so no row is ever left with a hole.
const wide = (i: number) => !album && photos.length % 2 === 1 && i === 0;
---
{photos.length > 0 && (
  <section class:list={['gallery', { album }]} aria-label={s.label}>
    <div class="grid">
      {photos.map((p, i) => (
        <figure class:list={{ wide: wide(i) }}>
          <a href={p.large} data-index={i} data-caption={p.caption} data-alt={p.alt}>
            <Image src={p.src} alt={p.alt} widths={wide(i) ? [640, 1024, 1600, 2200] : [480, 720, 1100]} sizes={wide(i) ? '(min-width: 1280px) 1240px, 100vw' : album ? '(min-width: 1100px) 33vw, (min-width: 600px) 50vw, 100vw' : '(min-width: 760px) 50vw, 100vw'} loading="lazy" />
          </a>
          {p.caption && <figcaption><span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
    <dialog class="lightbox" aria-label={s.viewer}>
      <img alt="" />
      <p class="lb-caption"></p>
      <button class="lb-close" aria-label={s.close}>×</button>
      <button class="lb-prev" aria-label={s.prev}>‹</button>
      <button class="lb-next" aria-label={s.next}>›</button>
    </dialog>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const links = [...g.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const dlg = g.querySelector<HTMLDialogElement>('dialog')!;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector<HTMLElement>('.lb-caption')!;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + links.length) % links.length;
      img.src = links[idx].href;
      img.alt = links[idx].dataset.alt || links[idx].dataset.caption || '';
      cap.textContent = links[idx].dataset.caption || '';
    };
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); show(i); dlg.showModal(); }));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    // Swipe on phones.
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  });
</script>

<style>
  .gallery { margin: 0; }
  .album .grid { gap: 1rem; }
  .album figure a { aspect-ratio: 4 / 3; }
  @media (min-width: 600px) { .album .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .album .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid { display: grid; grid-template-columns: 1fr; gap: clamp(1rem, 2.5vw, 2rem); }
  @media (min-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .wide { grid-column: 1 / -1; } }
  figure { margin: 0; }
  figure a { display: block; overflow: hidden; aspect-ratio: 4 / 5; background: var(--panel); border-radius: var(--radius); cursor: zoom-in; }
  .wide a { aspect-ratio: 16 / 9; }
  @media (max-width: 759px) { figure a, .wide a { aspect-ratio: 3 / 2; } }
  figure :global(img) { width: 100%; height: 100%; object-fit: contain; }
  figcaption { display: flex; gap: 0.7rem; margin-top: 0.6rem; font-size: 0.95rem; font-style: italic; color: var(--ink-2); line-height: 1.4; }
  .num { font: 600 0.76rem/1.9 var(--label); font-style: normal; letter-spacing: 0.07em; color: var(--muted); }
  .lightbox {
    border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh;
    width: 100vw; height: 100vh; margin: 0;
  }
  .lightbox[open] { display: grid; place-items: center; grid-template-rows: 1fr auto; }
  .lightbox::backdrop { background: rgb(8 14 20 / 0.97); }
  .lightbox img { max-width: 94vw; max-height: 84vh; object-fit: contain; align-self: end; }
  .lb-caption { color: #e8ebe4; margin: 0.9rem 1rem 1.5rem; text-align: center; font-size: 1rem; font-style: italic; min-height: 1.5em; }
  .lightbox button {
    position: fixed; background: rgb(255 255 255 / 0.1); color: #fff; border: 1px solid rgb(255 255 255 / 0.25); cursor: pointer;
    width: 3rem; height: 3rem; border-radius: 999px; font-size: 1.5rem; line-height: 1;
    transition: background-color 200ms ease;
  }
  .lightbox button:hover { background: rgb(255 255 255 / 0.22); }
  .lightbox button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 1rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 1rem; top: 50%; translate: 0 -50%; }
</style>
