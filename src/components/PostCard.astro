---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import { formatDate, postUrl, type Post } from '../lib/posts';

interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const cover = resolveImage(post.data.cover);
---
<article class:list={['card', { featured }]}>
  <a href={postUrl(post)} class="card-link">
    <div class="media">
      {cover ? (
        <Image src={cover} alt={post.data.coverAlt ?? ''} widths={featured ? [640, 960, 1400] : [400, 640, 900]} sizes={featured ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'} loading={featured ? 'eager' : 'lazy'} />
      ) : (
        <div class="placeholder" aria-hidden="true"></div>
      )}
      {post.data.draft && <span class="draft">Draft</span>}
    </div>
    <div class="body">
      <span class="eyebrow">{post.data.location}</span>
      <h2>{post.data.title}</h2>
      {post.data.summary && <p>{post.data.summary}</p>}
      <span class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
    </div>
  </a>
</article>

<style>
  .card-link { display: grid; gap: 1rem; color: inherit; text-decoration: none; }
  .media { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--paper-2); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .card-link:hover .media :global(img) { transform: scale(1.03); }
  .placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #0e5c57, #c0532b); opacity: 0.25; }
  .draft { position: absolute; top: 0.75rem; left: 0.75rem; background: var(--ink); color: #fff; font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 999px; }
  .body { display: grid; gap: 0.35rem; }
  h2 { font-size: 1.4rem; margin: 0; transition: color 150ms ease; }
  .card-link:hover h2 { color: var(--teal); }
  p { margin: 0; color: var(--ink-soft); font-size: 0.98rem; }
  .featured .card-link { gap: 1.5rem; }
  .featured h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); }
  .featured p { font-size: 1.1rem; }
  @media (min-width: 900px) {
    .featured .card-link { grid-template-columns: 1.5fr 1fr; align-items: center; gap: 2.5rem; }
    .featured .media { aspect-ratio: 3 / 2; }
  }
</style>
