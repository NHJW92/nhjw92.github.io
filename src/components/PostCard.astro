---
import { Image } from 'astro:assets';
import Dateline from './Dateline.astro';
import { resolveImage } from '../lib/images';
import { postUrl, type Post } from '../lib/posts';
import type { Leg } from '../lib/journey';
import { formatDate, t } from '../i18n/ui';

interface Props {
  post: Post;
  /** 'feature' = wide split layout; 'card' = photo on top. */
  variant?: 'feature' | 'card';
  /** Mirror the feature layout (photo on the right). */
  flip?: boolean;
  leg?: Leg;
}
const { post, variant = 'card', flip = false, leg } = Astro.props;
const cover = resolveImage(post.data.cover);
const s = t(post.lang);
const feature = variant === 'feature';
---
<article class:list={['story', variant, { flip }]}>
  <a href={postUrl(post)} class="link">
    <div class="media">
      {cover ? (
        <Image
          src={cover}
          alt={post.data.coverAlt ?? ''}
          widths={feature ? [640, 960, 1400, 1800] : [480, 720, 960]}
          sizes={feature ? '(min-width: 960px) 58vw, 100vw' : '(min-width: 960px) 30vw, (min-width: 640px) 50vw, 100vw'}
          loading="lazy"
        />
      ) : (
        <div class="placeholder" aria-hidden="true"><span>{post.data.location}</span></div>
      )}
      {post.data.draft && <span class="draft">{s.post.draft}</span>}
    </div>
    <div class="body">
      {leg ? <Dateline leg={leg} lang={post.lang} size="sm" /> : <span class="kicker">{post.data.location}</span>}
      <h3>{post.data.title}</h3>
      {post.data.summary && <p class="sum">{post.data.summary}</p>}
      <span class="meta">{leg && <>{post.data.location} · </>}<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, post.lang)}</time></span>
    </div>
  </a>
</article>

<style>
  .link { display: grid; gap: 1.1rem; color: inherit; text-decoration: none; }
  .media { position: relative; overflow: hidden; background: var(--panel); aspect-ratio: 4 / 5; border-radius: var(--radius); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.001); transition: transform 1200ms var(--ease-out); }
  .link:hover .media :global(img) { transform: scale(1.04); }
  .placeholder {
    width: 100%; height: 100%; display: grid; place-items: end start; padding: 1.25rem;
    background: radial-gradient(120% 80% at 20% 0%, #2a4a5f, var(--deep));
    color: var(--on-deep); font-family: var(--display); font-size: 1.6rem; font-style: italic;
  }
  .draft {
    position: absolute; top: 0.75rem; left: 0.75rem; background: var(--accent); color: #121a22;
    font: 600 0.76rem var(--label); letter-spacing: 0.07em; text-transform: uppercase; padding: 0.3rem 0.66rem;
  }
  .body { display: grid; gap: 0.6rem; align-content: start; }
  h3 { margin: 0; font-size: clamp(1.5rem, 2.4vw, 1.9rem); line-height: 1.08; transition: opacity 200ms var(--ease-soft); }
  .sum { margin: 0; color: var(--ink-2); font-size: 1.05rem; line-height: 1.5; max-width: 42ch; }
  .link:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }

  .feature .media { aspect-ratio: 3 / 2; }
  .feature h3 { font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1; }
  .feature .sum { font-size: 1.2rem; font-style: italic; }
  @media (min-width: 960px) {
    .feature .link { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
    .feature.flip .media { order: 2; }
    .feature .media { aspect-ratio: 5 / 4; }
  }
</style>
