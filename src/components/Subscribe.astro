---
import { SITE } from '../site.config';
import { localize, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).subscribe;
const user = SITE.buttondownUsername;
---
<aside class="subscribe on-deep">
  <div>
    <h2>{s.title}</h2>
    <p>{s.text}</p>
  </div>
  {user ? (
    <form action={`https://buttondown.com/api/emails/embed-subscribe/${user}`} method="post" target="_blank" class="form">
      <label for="bd-email" class="visually-hidden">{s.emailLabel}</label>
      <input type="hidden" name="tag" value={lang} />
      <input type="email" name="email" id="bd-email" placeholder="you@example.com" required autocomplete="email" />
      <button class="btn" type="submit">{s.button}</button>
    </form>
  ) : (
    <p class="fallback">{s.rssPrefix} <a href={localize('/rss.xml', lang)}>{s.rssLink}</a>.</p>
  )}
</aside>

<style>
  .subscribe {
    display: grid; gap: 1.5rem; align-content: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: radial-gradient(120% 120% at 100% 0%, #1f3a4d 0%, var(--deep) 65%);
  }
  h2 { margin: 0 0 0.4rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  p { margin: 0; color: var(--ink-2); font-style: italic; }
  a { color: var(--ink); text-decoration-color: var(--accent); text-decoration-thickness: 2px; font-style: normal; }
  .form { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  input {
    flex: 1 1 14rem; min-width: 0; min-height: 3rem; padding: 0.7rem 1.1rem; border-radius: 999px;
    border: 1px solid var(--line-strong); background: transparent; color: var(--ink);
    font: 500 0.95rem var(--mono);
  }
  input::placeholder { color: var(--muted); opacity: 1; }
  input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .btn { background: var(--accent); color: #121a22; }
  .btn:hover { background: var(--accent-hover); color: #121a22; }
</style>
