---
import { SITE } from '../site.config';
const user = SITE.buttondownUsername;
---
<aside class="subscribe">
  <div>
    <h2>Follow along</h2>
    <p>Get an email when a new story goes up. No spam, unsubscribe any time.</p>
  </div>
  {user ? (
    <form action={`https://buttondown.com/api/emails/embed-subscribe/${user}`} method="post" target="_blank" class="form">
      <label for="bd-email" class="visually-hidden">Email address</label>
      <input type="email" name="email" id="bd-email" placeholder="you@example.com" required autocomplete="email" />
      <button class="btn" type="submit">Subscribe</button>
    </form>
  ) : (
    <p class="fallback">Prefer a feed reader? <a href="/rss.xml">Subscribe via RSS</a>.</p>
  )}
</aside>

<style>
  .subscribe {
    display: grid; gap: 1.25rem; align-items: center;
    background: var(--teal); color: #eaf2ef; border-radius: calc(var(--radius) + 6px);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  h2 { color: #fff; margin: 0 0 0.3rem; }
  p { margin: 0; }
  a { color: #fff; }
  .form { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  input {
    flex: 1 1 14rem; min-width: 0; padding: 0.7rem 1rem; border-radius: 999px; border: 1px solid transparent;
    font: inherit; font-size: 1rem; background: #fff; color: var(--ink);
  }
  .btn { background: var(--clay); }
  .btn:hover { background: #a6441f; }
  @media (min-width: 760px) { .subscribe { grid-template-columns: 1fr 1fr; } }
</style>
