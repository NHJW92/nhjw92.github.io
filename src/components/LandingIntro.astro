---
import { SITE } from '../site.config';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; location?: string }
const { lang, location } = Astro.props;
const s = t(lang);
---
<div class="landing-intro">
  <p class="kicker">{s.home.journal} · {s.edition}{location && <span> · {s.home.currentlyIn(location)}</span>}</p>
  <h1>{SITE.title}</h1>
  <p class="welcome">{s.home.welcome}</p>
</div>
<style>
  .landing-intro { max-width: 64rem; }
  .kicker { margin: 0 0 1rem; color: inherit; }
  h1 { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(3rem, 8vw, 7rem); line-height: 0.98; letter-spacing: -0.03em; text-wrap: balance; }
  .welcome { max-width: 46ch; margin: 1.4rem 0 0; font-size: clamp(1.05rem, 2vw, 1.35rem); color: var(--ink-2); }
</style>
