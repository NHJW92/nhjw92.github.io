---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { getPosts } from '../lib/posts';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
// Only photos actually used in published stories belong in the album.
// getPosts is newest-first; a shared photo is shown once with its latest caption.
const photos = new Map<string, { image: string; caption?: string; alt: string }>();
const addPhoto = (path?: string | null, caption?: string | null) => {
  if (!path) return;
  const image = decodeURIComponent(path.trim());
  if (!image.startsWith('/uploads/') || photos.has(image)) return;
  photos.set(image, { image, caption: caption || undefined, alt: caption || s.photos.alt(photos.size + 1) });
};
for (const post of (await getPosts(lang)).filter((post) => !post.data.draft)) {
  addPhoto(post.data.cover, post.data.coverAlt);
  for (const photo of post.data.gallery) addPhoto(photo.image, photo.caption);
  // Include uploaded images inserted directly into the story text, too.
  const body = (post.entry.body ?? '').replace(/```[\s\S]*?```|~~~[\s\S]*?~~~/g, '');
  for (const match of body.matchAll(/!\[([^\]]*)\]\(\s*(?:<([^>]+)>|([^\s)]+))(?:\s+["'][^\n]*?["'])?\s*\)/g)) {
    addPhoto(match[2] || match[3], match[1]);
  }
  for (const match of body.matchAll(/<img\b[^>]*>/gi)) {
    const src = match[0].match(/\bsrc\s*=\s*["']([^"']+)["']/i)?.[1];
    const alt = match[0].match(/\balt\s*=\s*["']([^"']*)["']/i)?.[1];
    addPhoto(src, alt);
  }
}
const items = [...photos.values()];
---
<Base lang={lang} title={s.nav.photos} description={s.photos.description}>
  <header class="wrap head">
    <p class="kicker">{s.home.journal} · {s.photos.count(items.length)}</p>
    <h1>{s.nav.photos}</h1>
    <p class="intro">{s.photos.description}</p>
    {items.length > 0 && <p class="hint">{s.photos.hint}</p>}
  </header>
  <div class="wrap album">
    {items.length > 0 ? <Gallery items={items} lang={lang} album /> : <p>{s.photos.empty}</p>}
  </div>
</Base>
<style>
  .head { padding: clamp(3rem, 7vw, 5rem) 0 2rem; }
  .kicker { margin: 0; }
  h1 { margin: 0.8rem 0 1.2rem; }
  .intro { color: var(--ink-2); max-width: 45ch; font-size: 1.2rem; }
  .hint { color: var(--muted); font-family: var(--label); font-size: 0.9rem; max-width: 65ch; }
  .album { padding-top: 1.5rem; border-top: 1px solid var(--line); }
</style>
