---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import LandingIntro from '../components/LandingIntro.astro';
import PostCard from '../components/PostCard.astro';
import RouteMap from '../components/RouteMap.astro';
import Subscribe from '../components/Subscribe.astro';
import Donate from '../components/Donate.astro';
import { SITE } from '../site.config';
import { getPosts, postUrl, routePoints, type Post } from '../lib/posts';
import { resolveImage } from '../lib/images';
import { legFor, pad2, routeKm } from '../lib/journey';
import { localize, t, LOCALES, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const posts = await getPosts(lang);
const firstStory = posts.at(-1);
const points = routePoints(posts, lang);
const current = points.at(-1);
const legOf = (p: Post) => legFor(points, postUrl(p));
const cover = resolveImage(firstStory?.data.cover);


// All stories, newest first: wide features followed by a three-column grid.
const featureCount = posts.length ? ((posts.length - 1) % 3) + 1 : 0;
const features = posts.slice(0, featureCount);
const grid = posts.slice(featureCount);

// Logbook numbers
const nf = new Intl.NumberFormat(LOCALES[lang]);
const stats = [
  { value: nf.format(points.length), label: s.home.stats.stops },
  { value: nf.format(posts.length), label: s.home.stats.stories },
  { value: nf.format(routeKm(points)), label: s.home.stats.km },
];
// Latest stop first; numbers still count from the start of the trip.
const recent = points.map((p, i) => ({ ...p, n: i + 1 })).reverse().slice(0, 5);
---
<Base lang={lang} overlay={Boolean(cover)}>
  {cover ? (
    <Cover image={cover} alt={firstStory?.data.coverAlt ?? ''}>
      <LandingIntro lang={lang} location={current?.location} />
    </Cover>
  ) : (
    <section class="type-cover on-deep">
      <div class="wrap"><LandingIntro lang={lang} location={current?.location} /></div>
    </section>
  )}
  {posts.length > 0 ? (
    <section id="stories" class="wrap stories" aria-labelledby="stories-title">
      <header class="section-head" data-reveal>
        <h2 id="stories-title">{s.nav.stories}</h2>
      </header>
      <div class="features">
        {features.map((p, i) => <PostCard post={p} variant="feature" flip={i % 2 === 1} leg={legOf(p)} />)}
      </div>
      {grid.length > 0 && (
        <div class="grid">
          {grid.map((p) => <PostCard post={p} leg={legOf(p)} />)}
        </div>
      )}
    </section>
  ) : (
    <section id="stories" class="wrap stories"><h2>{s.nav.stories}</h2><p>{s.home.empty}</p></section>
  )}

  <section class:list={['wrap', 'letter', { ruled: posts.length > 0 }]} aria-label={s.home.journal}>
    <div class="note" data-reveal>
      <p class="kicker">{s.home.journal} · {s.edition}</p>
      <p class="statement">{s.tagline}</p>
      <p class="byline">{s.home.byline}</p>
    </div>
    <dl class="stats" data-reveal>
      {stats.map((x) => (
        <div><dt>{x.label}</dt><dd>{x.value}</dd></div>
      ))}
    </dl>
  </section>

  <section class="route on-deep" aria-labelledby="route-title">
    <div class="wrap route-in">
      <div class="route-copy" data-reveal>
        <p class="kicker">{s.map.stopsSoFar(points.length)}</p>
        <h2 id="route-title">{s.home.routeTitle}</h2>
        {recent.length > 0 && (
          <ol class="log" reversed>
            {recent.map((p) => (
              <li>
                <span class="n" aria-hidden="true">{pad2(p.n)}</span>
                <span class="where">{p.url ? <a href={p.url}>{p.location}</a> : p.title}</span>
                <span class="meta">{p.date} · {s.travel[p.travel]}</span>
              </li>
            ))}
          </ol>
        )}
        <a class="btn accent" href={localize('/map/', lang)}>{s.home.fullMap.replace(' →', '')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="route-map-wrap" data-reveal="fade">
        <RouteMap points={points} height="clamp(22rem, 60vh, 36rem)" lang={lang} />
      </div>
    </div>
  </section>

  <section class="wrap support">
    <Donate lang={lang} compact />
    <Subscribe lang={lang} />
  </section>
</Base>

<style>
  .type-cover { padding: clamp(5rem, 12vw, 9rem) 0 clamp(3rem, 8vw, 5rem); background: radial-gradient(120% 90% at 85% 0%, #1f3a4d 0%, var(--deep) 60%); }

  /* Editor's letter + logbook numbers */
  .letter { display: grid; gap: 2.5rem; padding: clamp(4rem, 9vw, 7rem) 0 clamp(1rem, 3vw, 2rem); }
  .letter.ruled { padding-bottom: clamp(4rem, 9vw, 7rem); border-bottom: 1px solid var(--line); }
  .note .kicker { margin: 0 0 1rem; }
  .statement { margin: 0; font-family: var(--display); font-style: italic; font-weight: 400; font-size: clamp(1.7rem, 3.6vw, 2.8rem); line-height: 1.15; max-width: 26ch; text-wrap: balance; }
  .byline { margin: 1.4rem 0 0; font-family: var(--label); font-size: 0.84rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .stats { display: grid; grid-template-columns: minmax(4.5rem, auto) minmax(4.5rem, auto) minmax(0, 1fr); gap: 1.5rem; margin: 0; align-self: end; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 0.4rem; border-top: 1px solid var(--ink); padding-top: 0.8rem; }
  .stats dt { font-family: var(--label); font-size: 0.76rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--display); font-size: clamp(1.9rem, 4vw, 3.4rem); line-height: 1; white-space: nowrap; font-variant-numeric: lining-nums tabular-nums; }
  @media (min-width: 900px) { .letter { grid-template-columns: 1.3fr 1fr; align-items: end; gap: 4rem; } }

  /* Earlier stories */
  .stories { scroll-margin-top: 7rem; padding-top: clamp(4rem, 8vw, 6rem); }
  .section-head { display: flex; align-items: baseline; gap: 1.2rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .section-head h2 { margin: 0; }
  .features { display: grid; gap: clamp(3.5rem, 8vw, 6rem); }
  .grid { display: grid; gap: 3rem 2rem; margin-top: clamp(3.5rem, 8vw, 6rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Route band */
  .route { margin-top: clamp(5rem, 10vw, 8rem); padding: clamp(4rem, 8vw, 6rem) 0; }
  .route-in { display: grid; gap: 2.5rem; }
  .route-copy { display: grid; gap: 1rem; align-content: start; justify-items: start; }
  .route-copy h2 { margin: 0 0 0.5rem; }
  .route-copy .kicker { margin: 0; }
  .log { list-style: none; margin: 0 0 1.2rem; padding: 0; width: 100%; }
  .log li { display: grid; grid-template-columns: 2.6rem 1fr; column-gap: 0.75rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .log li:first-child .n { color: var(--accent); }
  .n { grid-row: span 2; font-family: var(--display); font-size: 1.6rem; line-height: 1.1; }
  .where { font-family: var(--display); font-size: 1.2rem; line-height: 1.25; }
  .where a { text-decoration-color: var(--line-strong); }
  .where a:hover { text-decoration-color: var(--accent); }
  @media (min-width: 960px) { .route-in { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 4rem; align-items: start; } }

  /* Support */
  .support { display: grid; gap: 1.5rem; margin-top: clamp(4rem, 8vw, 6rem); }
  @media (min-width: 1100px) { .support { grid-template-columns: 1.15fr 1fr; align-items: stretch; } }
</style>
