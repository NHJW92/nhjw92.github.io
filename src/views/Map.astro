---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import { getPosts, routePoints } from '../lib/posts';
import { formatCoords, pad2, routeKm } from '../lib/journey';
import { t, LOCALES, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const points = routePoints(await getPosts(lang), lang);
// Latest stop first in the list; numbers still count from the start of the trip.
const listed = points.map((p, i) => ({ ...p, n: i + 1 })).reverse();
const km = new Intl.NumberFormat(LOCALES[lang]).format(routeKm(points));
---
<Base lang={lang} title={s.map.title} description={s.map.description}>
  <header class="wrap head">
    <p class="kicker">{s.map.stopsSoFar(points.length)} · {km} {s.home.stats.km}</p>
    <h1>{s.map.title}</h1>
    <p class="dek">{s.map.description}</p>
  </header>
  <section class="wrap">
    <RouteMap points={points} height="min(74vh, 46rem)" lang={lang} />
    {points.length > 0 && (
      <ol class="stops" reversed>
        {listed.map((p, i) => (
          <li data-reveal>
            {p.url ? (
              <a href={p.url} class:list={['row', { latest: i === 0 }]}>
                <span class="n" aria-hidden="true">{pad2(p.n)}</span>
                <span class="what"><span class="kicker">{p.location}</span><strong>{p.title}</strong></span>
                <span class="meta">{p.date}<br />{s.travel[p.travel]} · {formatCoords(p.lat, p.lng)}</span>
              </a>
            ) : (
              <div class:list={['row', 'stop', { latest: i === 0 }]}>
                <span class="n" aria-hidden="true">{pad2(p.n)}</span>
                <span class="what"><span class="kicker">{s.map.stop}</span><strong>{p.title}</strong>{p.note && <span class="note">{p.note}</span>}</span>
                <span class="meta">{p.date}<br />{s.travel[p.travel]} · {formatCoords(p.lat, p.lng)}</span>
              </div>
            )}
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .head { padding: clamp(3rem, 8vw, 6rem) 0 clamp(1.5rem, 4vw, 2.5rem); }
  .head h1 { margin: 0.6rem 0 0.8rem; }
  .head .kicker { margin: 0; }
  .head .dek { margin: 0; color: var(--ink-2); }
  .stops { list-style: none; padding: 0; margin: clamp(2.5rem, 6vw, 4rem) 0 0; border-top: 1px solid var(--ink); }
  .row {
    display: grid; grid-template-columns: 3.2rem 1fr; gap: 0.3rem 1rem; padding: 1.1rem 0;
    border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); align-items: baseline;
  }
  .n { grid-row: span 2; font-family: var(--display); font-size: 2rem; line-height: 1; font-variant-numeric: lining-nums; }
  .latest .n::after { content: ''; display: block; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--accent); margin-top: 0.5rem; }
  .what { display: grid; gap: 0.2rem; }
  .what .kicker { font-size: 0.68rem; }
  .what strong { font-family: var(--display); font-weight: 500; font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.15; }
  .note { font-style: italic; color: var(--ink-2); font-size: 1rem; }
  .stop strong { color: var(--ink-2); }
  .meta { grid-column: 2; line-height: 1.6; }
  a.row:hover strong { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  @media (min-width: 760px) {
    .row { grid-template-columns: 4rem 1fr auto; }
    .n { grid-row: auto; }
    .meta { grid-column: auto; text-align: right; }
  }
</style>
