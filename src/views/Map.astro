---
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import { getPosts, routePoints } from '../lib/posts';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const points = routePoints(await getPosts(lang), lang);
---
<Base lang={lang} title={s.map.title} description={s.map.description}>
  <section class="wrap head">
    <p class="eyebrow">{s.map.stopsSoFar(points.length)}</p>
    <h1>{s.map.title}</h1>
  </section>
  <section class="wrap">
    <RouteMap points={points} height="min(72vh, 44rem)" lang={lang} />
    {points.length > 0 && (
      <ol class="stops">
        {points.map((p) => (
          <li>
            {p.url ? (
              <a href={p.url} class="row"><span class="eyebrow">{p.location}</span><strong>{p.title}</strong><span class="meta">{p.date} · {s.travel[p.travel]}</span></a>
            ) : (
              <div class="row stop"><span class="eyebrow">{s.map.stop}</span><strong>{p.title}</strong><span class="meta">{p.date} · {s.travel[p.travel]}{p.note && ` · ${p.note}`}</span></div>
            )}
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .head { padding: clamp(2.5rem, 6vw, 4rem) 0 1.5rem; }
  .head h1 { margin: 0.3rem 0 0; }
  .stops { list-style: none; padding: 0; margin: 2.5rem 0 0; counter-reset: stop; display: grid; gap: 0.25rem; }
  .stops li { counter-increment: stop; }
  .row {
    display: grid; grid-template-columns: 2.5rem 1fr; column-gap: 0.75rem; padding: 0.9rem 0;
    border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink);
  }
  .row::before { content: counter(stop); grid-row: span 3; font-family: var(--serif); font-size: 1.5rem; color: var(--clay); }
  .stops strong { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; }
  .stop strong { font-weight: 500; color: var(--ink-soft); }
  a.row:hover strong { color: var(--teal); }
</style>
