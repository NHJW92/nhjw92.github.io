---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import Donate from '../components/Donate.astro';
import { SITE } from '../site.config';
import { localize, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const all = t(lang);
const s = all.about;
// Edit the About text in src/i18n/ui.ts (one version per language).
const paragraphs = s.paragraphs.map((p) => p.replace('{route}', localize('/map/', lang)));
---
<Base lang={lang} title={s.title}>
  <header class="wrap head">
    <p class="kicker">{s.title} · {SITE.author}</p>
    <h1>{s.heading}</h1>
  </header>
  <section class="prose-wrap prose dropcap">
    {paragraphs.map((p) => <p set:html={p} />)}
  </section>
  <div class="prose-wrap stack"><Donate lang={lang} compact /><Subscribe lang={lang} /></div>
</Base>

<style>
  .head { padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2rem, 5vw, 3rem); border-bottom: 1px solid var(--line); margin-bottom: clamp(2rem, 5vw, 3rem); }
  .head h1 { margin: 0.8rem 0 0; max-width: 16ch; }
  .head .kicker { margin: 0; }
  .stack { display: grid; gap: 1.25rem; margin-top: clamp(3rem, 6vw, 4.5rem); }
</style>
