---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import { localize, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).about;
// Edit the About text in src/i18n/ui.ts (one version per language).
const paragraphs = s.paragraphs.map((p) => p.replace('{route}', localize('/map/', lang)));
---
<Base lang={lang} title={s.title}>
  <section class="prose-wrap prose head">
    <p class="eyebrow">{s.title}</p>
    <h1>{s.heading}</h1>
    {paragraphs.map((p) => <p set:html={p} />)}
  </section>
  <div class="prose-wrap"><Subscribe lang={lang} /></div>
</Base>

<style>
  .head { padding: clamp(2.5rem, 7vw, 5rem) 0 2rem; }
  .head h1 { margin: 0.4rem 0 1.2rem; }
</style>
