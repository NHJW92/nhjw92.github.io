---
import Base from '../layouts/Base.astro';
import { getPosts, routePoints } from '../lib/posts';
import { routeKm } from '../lib/journey';
import { t, LOCALES, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const posts = await getPosts(lang);
const points = routePoints(posts, lang);
const nf = new Intl.NumberFormat(LOCALES[lang]);
const stats = [
  { value: points.length, label: s.home.stats.stops },
  { value: posts.length, label: s.home.stats.stories },
  { value: routeKm(points), label: s.home.stats.km },
];
---

<Base lang={lang} title={s.nav.stats}>
  <section class="wrap journal" aria-labelledby="stats-title">
    <header>
      <p class="kicker">{s.home.journal} · {s.edition}</p>
      <h1 id="stats-title">{s.nav.stats}</h1>
      <p class="statement">{s.tagline}</p>
      <p class="byline">{s.home.byline}</p>
    </header>
    <dl class="stats">
      {stats.map(({ label, value }) => (
        <div><dt>{label}</dt><dd>{nf.format(value)}</dd></div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .journal { display: grid; gap: 2.5rem; padding-top: clamp(3rem, 8vw, 6rem); }
  .kicker { margin: 0; }
  h1 { margin: 0.6rem 0 1.2rem; }
  .statement { margin: 0; font-family: var(--display); font-style: italic; font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.15; max-width: 26ch; text-wrap: balance; }
  .byline { margin: 1.4rem 0 0; font-family: var(--label); font-size: 0.84rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: 1.5rem; margin: 0; align-self: end; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 0.4rem; border-top: 1px solid var(--ink); padding-top: 0.8rem; }
  .stats dt { font-family: var(--label); font-size: 0.76rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .stats dd { margin: 0; font-family: var(--display); font-size: clamp(1.9rem, 4vw, 3.4rem); line-height: 1; font-variant-numeric: lining-nums tabular-nums; }
  @media (min-width: 900px) { .journal { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
</style>
