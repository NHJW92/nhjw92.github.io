---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Dateline from '../components/Dateline.astro';
import Gallery from '../components/Gallery.astro';
import Subscribe from '../components/Subscribe.astro';
import Donate from '../components/Donate.astro';
import Comments from '../components/Comments.astro';
import RouteMap from '../components/RouteMap.astro';
import { resolveImage } from '../lib/images';
import { postUrl, routePoints, type Post } from '../lib/posts';
import { legFor } from '../lib/journey';
import { formatDate, localize, t } from '../i18n/ui';

interface Props { post: Post; newer?: Post; older?: Post; all: Post[] }
const { post, newer, older, all } = Astro.props;
const lang = post.lang;
const s = t(lang);
const { Content } = await render(post.entry);
const cover = resolveImage(post.data.cover);
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
const hasCoords = typeof post.data.lat === 'number' && typeof post.data.lng === 'number';
const sourceName = s.langNames[post.sourceLang];
const originalUrl = localize(`/posts/${post.id}/`, post.sourceLang);
const points = routePoints(all, lang);
const leg = legFor(points, postUrl(post));
const words = (post.entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const date = formatDate(post.data.date, lang);
const pager = [
  older && { post: older, label: s.post.previous, cls: 'prev' },
  newer && { post: newer, label: s.post.next, cls: 'next' },
].filter(Boolean) as { post: Post; label: string; cls: string }[];
---
<Base lang={lang} title={post.data.title} description={post.data.summary ?? undefined} image={ogImage} overlay={Boolean(cover)}>
  <article>
    {cover ? (
      <Cover image={cover} alt={post.data.coverAlt ?? ''}>
        <header class="opener">
          <p class="kicker loc">{post.data.location}</p>
          <h1>{post.data.title}</h1>
          {leg && <Dateline leg={leg} lang={lang} />}
        </header>
      </Cover>
    ) : (
      <header class="wrap opener plain">
        <p class="kicker loc">{post.data.location}</p>
        <h1>{post.data.title}</h1>
        {leg && <Dateline leg={leg} lang={lang} />}
      </header>
    )}

    <div class="prose-wrap standfirst">
      <p class="meta">
        <span>{post.data.author ? s.home.writtenBy(post.data.author) : s.home.byline}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{date}</time>
        <span aria-hidden="true">·</span>
        <span>{s.post.readingTime(minutes)}</span>
        {post.data.draft && <><span aria-hidden="true">·</span><span class="draft">{s.post.draft}</span></>}
      </p>
      {post.status === 'translated' && (
        <p class="notice">{s.post.machineTranslated(sourceName)} <a href={originalUrl} hreflang={post.sourceLang}>{t(post.sourceLang).langNames[post.sourceLang]} ↗</a></p>
      )}
      {post.status === 'missing' && <p class="notice">{s.post.notYetTranslated(sourceName)}</p>}
      <div class="layout-toggle" role="group" aria-label={s.post.layout} data-layout-toggle hidden>
        <span class="label">{s.post.layout}</span>
        <button type="button" data-cols="1" aria-pressed="true">{s.post.oneColumn}</button>
        <button type="button" data-cols="2" aria-pressed="false">{s.post.twoColumns}</button>
      </div>
    </div>

    <div class="prose-wrap prose dropcap" data-prose lang={post.status === 'missing' ? post.sourceLang : undefined}>
      <Content />
    </div>

    {post.data.gallery.length > 0 && (
      <div class="wrap essay">
        <header class="essay-head">
          <p class="kicker">{s.post.photos} · {post.data.gallery.length}</p>
          <span class="rule" aria-hidden="true"></span>
        </header>
        <Gallery items={post.data.gallery} lang={lang} />
      </div>
    )}

    {hasCoords && (
      <section class="wrap where" aria-labelledby="where-title">
        <div class="where-head">
          <p class="kicker">{leg ? leg.coords : post.data.location}</p>
          <h2 id="where-title">{s.post.whereTitle}</h2>
        </div>
        <RouteMap points={points} height="clamp(18rem, 50vh, 28rem)" focus={{ lat: post.data.lat!, lng: post.data.lng! }} lang={lang} />
      </section>
    )}

    <div class="prose-wrap"><Comments lang={lang} term={post.id} /></div>

    <section class="wrap support" aria-label={s.donate.title}>
      <Donate lang={lang} compact />
      <Subscribe lang={lang} />
    </section>

    {pager.length > 0 && (
      <nav class="wrap pager" aria-label={s.nav.stories}>
        {pager.map(({ post: p, label, cls }) => {
          const img = resolveImage(p.data.cover);
          return (
            <a href={postUrl(p)} class:list={['turn', cls]} data-reveal>
              <span class="turn-media">
                {img ? <Image src={img} alt="" widths={[480, 800, 1200]} sizes="(min-width: 800px) 50vw, 100vw" loading="lazy" /> : <span class="turn-ph" aria-hidden="true"></span>}
              </span>
              <span class="turn-copy">
                <span class="kicker">{label}</span>
                <span class="turn-title">{p.data.title}</span>
                <span class="meta">{p.data.location}</span>
              </span>
            </a>
          );
        })}
      </nav>
    )}

  </article>
</Base>

<script>
  // Wide screens: readers can switch the story between one and two columns (one is the default).
  // Two columns are laid out in screen-sized blocks ("spreads"), each split over two balanced columns,
  // so you never have to scroll back up to find the top of the next column.
  const WIDE = matchMedia('(min-width: 1200px)');
  const KEY = 'te-columns';
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  const toggle = document.querySelector<HTMLElement>('[data-layout-toggle]');
  if (prose && toggle) {
    const original = [...prose.children];
    let cols = '1';
    try { cols = localStorage.getItem(KEY) === '2' ? '2' : '1'; } catch {}

    const single = () => {
      prose.classList.remove('two');
      prose.replaceChildren(...original);
    };

    const spreads = () => {
      single();
      prose.classList.add('two');
      const gap = parseFloat(getComputedStyle(prose).columnGap) || 64;
      const colWidth = (prose.clientWidth - gap) / 2;
      // Measure every block at column width, then group blocks until a group fills two columns
      // of at most ~70% of the screen height.
      const probe = document.createElement('div');
      probe.className = 'spread-probe';
      probe.style.width = `${colWidth}px`;
      prose.replaceChildren(probe);
      probe.append(...original);
      const limit = 2 * Math.max(320, innerHeight * 0.7);
      const groups: Element[][] = [];
      let group: Element[] = [];
      let height = 0;
      for (const el of original) {
        const cs = getComputedStyle(el);
        const h = (el as HTMLElement).offsetHeight + parseFloat(cs.marginTop) + parseFloat(cs.marginBottom);
        if (group.length && height + h > limit) { groups.push(group); group = []; height = 0; }
        group.push(el); height += h;
      }
      if (group.length) groups.push(group);
      prose.replaceChildren(...groups.map((g) => {
        const div = document.createElement('div');
        div.className = 'spread';
        div.append(...g);
        return div;
      }));
    };

    const apply = () => {
      toggle.hidden = !WIDE.matches;
      toggle.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cols === cols)));
      if (WIDE.matches && cols === '2') spreads(); else single();
    };

    toggle.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cols]');
      if (!b) return;
      cols = b.dataset.cols!;
      try { localStorage.setItem(KEY, cols); } catch {}
      apply();
    });
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(apply, 200); });
    WIDE.addEventListener('change', apply);
    apply();
    document.fonts?.ready.then(apply);
  }
</script>

<style>
  /* One or two columns (wide screens only) */
  .layout-toggle { display: flex; align-items: center; gap: 0.35rem; margin-top: 1rem; font-family: var(--label); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .layout-toggle[hidden] { display: none; }
  .layout-toggle .label { color: var(--muted); margin-right: 0.35rem; }
  .layout-toggle button {
    font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink); cursor: pointer;
    background: transparent; border: 1px solid var(--line-strong); border-radius: 999px; padding: 0.35rem 0.8rem;
    transition: background-color 150ms var(--ease-soft), border-color 150ms var(--ease-soft);
  }
  .layout-toggle button:hover { border-color: var(--ink); }
  .layout-toggle button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--canvas); }
  .prose.two { width: min(100% - 2 * var(--gutter), calc(2 * var(--prose) + 4rem)); column-gap: 4rem; }
  .prose.two :global(.spread) { columns: 2; column-gap: 4rem; column-rule: 1px solid var(--line); margin: 0 0 2.2rem; }
  .prose.two :global(.spread + .spread) { padding-top: 2.2rem; border-top: 1px solid var(--line); }
  .prose.two :global(.spread > *) { margin: 0 0 1.3em; }
  .prose.two :global(.spread > :last-child) { margin-bottom: 0; }
  .prose.two :global(.spread img), .prose.two :global(.spread blockquote) { break-inside: avoid; }
  .prose.two.dropcap :global(.spread:first-child > p:first-of-type::first-letter) {
    font-family: var(--display); font-weight: 500; float: left; font-size: 4.6em; line-height: 0.8;
    margin: 0.06em 0.1em 0 -0.02em; color: var(--ink);
  }
  .prose :global(.spread-probe > *) { margin: 0 0 1.3em; }

  .opener { display: grid; gap: 1rem; justify-items: start; max-width: 64rem; }
  .opener h1 { margin: 0; font-size: clamp(2.6rem, 6.5vw, 5.6rem); line-height: 1; letter-spacing: -0.025em; }
  .loc { margin: 0; color: inherit; }
  .plain { padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2rem, 5vw, 3rem); border-bottom: 1px solid var(--line); }

  .standfirst { padding: clamp(2rem, 5vw, 3rem) 0 1.5rem; }
  .standfirst .meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.66rem; margin: 0; text-transform: uppercase; letter-spacing: 0.07em; font-size: 0.78rem; }
  .draft { background: var(--accent); color: #121a22; padding: 0 0.4rem; }
  .notice {
    margin: 1.2rem 0 0; padding: 0.7rem 0.9rem; border-left: 2px solid var(--accent); background: var(--panel);
    color: var(--ink-2); font-size: 0.95rem; font-style: italic;
  }
  .notice a { white-space: nowrap; font-style: normal; }

  .essay { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .essay-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .essay-head .kicker { margin: 0; white-space: nowrap; }
  .rule { flex: 1; height: 1px; background: var(--ink); }

  .where { margin-top: clamp(4rem, 8vw, 6rem); display: grid; gap: 1.5rem; }
  .where-head h2 { margin: 0.4rem 0 0; }
  .where-head .kicker { margin: 0; }

  .pager { display: grid; gap: 1.5rem; margin-top: clamp(4rem, 8vw, 6rem); padding-top: 2rem; border-top: 1px solid var(--ink); }
  .turn { display: grid; grid-template-columns: 7rem 1fr; gap: 1.1rem; align-items: center; color: inherit; text-decoration: none; }
  .turn-media { display: block; aspect-ratio: 1; overflow: hidden; background: var(--panel); border-radius: var(--radius); }
  .turn-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1000ms var(--ease-out); }
  .turn:hover .turn-media :global(img) { transform: scale(1.05); }
  .turn-ph { display: block; width: 100%; height: 100%; background: radial-gradient(120% 80% at 20% 0%, #2a4a5f, var(--deep)); }
  .turn-copy { display: grid; gap: 0.3rem; }
  .turn-copy .kicker { color: var(--muted); }
  .turn-title { font-family: var(--display); font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.1; }
  .turn:hover .turn-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  @media (min-width: 800px) {
    .pager { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    .turn { grid-template-columns: 1fr; }
    .turn-media { aspect-ratio: 16 / 9; }
    .next { grid-column: 2; text-align: right; }
    .next .turn-copy { justify-items: end; }
  }

  /* Support band: coffee and follow, side by side on wide screens. */
  .support { display: grid; gap: 1.25rem; margin-top: clamp(4rem, 8vw, 6rem); }
  .support > :global(*) { margin: 0; }
  @media (min-width: 900px) { .support { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: stretch; } }
</style>
